# ===== RWA Exchange 生产环境变量 =====
# 复制为 .env 并填写真实值（详见 docs/DEPLOY.md）

# 链上 RPC（生产：Infura/Alchemy/自建节点；本地：Hardhat）
# 测试网示例：https://sepolia-rollup.arbitrum.io/rpc
# 主网示例（Arbitrum）：https://arb1.arbitrum.io/rpc
ETH_RPC_URL=http://localhost:8545

# 链 ID（必须与 RPC 对应的链一致！EIP-155 签名 + EIP-712 域都依赖它）
# Hardhat=31337 / Arbitrum Sepolia=421614 / Base Sepolia=84532
# Arbitrum=42161 / Base=8453 / Polygon=137
# 使用非本地 RPC 时未设置本项会拒绝启动（防用错链签名）
ETH_CHAIN_ID=31337

# 平台签名私钥（生产必须用 KMS/HSM 或加密环境变量，禁止硬编码）
# 警告：这是资产铸造/转账/代付 gas 的签名密钥，泄露=资产损失
# 二选一：直接填，或用 ETH_PRIVATE_KEY_FILE 指向密钥文件
ETH_PRIVATE_KEY=

# JWT 密钥（必须改为长随机串，例如 openssl rand -hex 32 的输出）
# 缺失或等于默认值会拒绝启动
JWT_SECRET=please-change-me-to-a-long-random-string

# 后端端口
PORT=8080

# 授权等级：community(免费演示) / pro(商业部署) / enterprise(白标+多租户)
LICENSE_TIER=pro
