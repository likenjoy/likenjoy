# ===== RWA Exchange 生产环境变量 =====
# 复制为 .env 并填写真实值

# 链上 RPC（生产：Infura/Alchemy/自建节点；本地：Hardhat）
ETH_RPC_URL=http://localhost:8545

# 平台签名私钥（生产必须用 KMS/HSM 或加密环境变量，禁止硬编码）
# 警告：这是资产铸造/转账的签名密钥，泄露=资产损失
ETH_PRIVATE_KEY=

# JWT 密钥（生产必须改为长随机串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 后端端口
PORT=8080
